---
// src/pages/work.astro
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Work | Portfolio</title>
  <style>
/* Base text styles matching your mockup */
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
  .main-container h1 {
    font-size: 5.5rem;
  }

  .main-container .hero-section p {
    font-size: 1.5rem;
    max-width: 700px;
  }
/* Outer layout wrapping the blueprint grid lines */
    .portfolio-carousel {
      margin-top: 5rem;
      position: relative;
    }

/* 3-Column blueprint structure */
    .carousel-viewport {
      overflow: hidden;
      height: 100vh;
      display: grid;
      grid-template-columns: 1fr 20px 1.2fr; /* Col 1: Text, Col 2: Spacer/Line, Col 3: Media */
      position: relative;
    }
    
    .carousel-track {
      grid-column: 1 / -1;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      height: auto;
      transition: transform 900ms cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
      z-index: 1;
    }

.project-slide {
  flex: 0 0 100vh;
  height: 100vh;
      min-height: 0;
      display: grid;
      grid-template-columns: 1fr 20px 1.2fr;
      align-items: center;
      padding: 2rem 0;
      box-sizing: border-box;
    }

    /* Left layout: Information Panel */

    article {
      gap: 3rem;
    }
    .project-card {
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: relative;
      height: auto;
      min-height: 24rem;
      justify-content: space-between;
    }

    .project-card-header {
      width: 100%;
    }

    .project-category {
      color: var(--primary);
      font-size: clamp(1rem, 1.2vw, 1.25rem);
      font-weight: 500;
      margin: 0 0 0.5rem 0;
    }

    .project-card h2 {
      font-size: clamp(2.0rem, 3.0vw, 3.8rem);
      font-weight: 700;
      margin: 0;
      color: var(--text);
    }

    .project-description {
      color: var(--description);
      margin: auto 0 2rem;
      font-size: clamp(0.95rem, 1.1vw, 1.15rem);
      line-height: 1.5;
      max-width: 32rem;
    }

    .project-date {
      color: var(--description);
      font-size: clamp(0.95rem, 1.1vw, 1.15rem);
      line-height: 1.5;
    }

    /* Interactive button element wrapper */
    .project-action-row {
      display: flex;
      width: 100%;
      justify-content: space-between;
      align-items: center;
    }

    .project-link {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: var(--text);
      color: var(--background);
      text-decoration: none;
      border-radius: 4px;
      font-weight: 600;
      transition: background-color 0.2s ease;
    }

    .project-link:hover {
      background-color: var(--secondary-alt);
      color: var(--text);
      transition: 0.35s;
    }

    /* Right Layout: Vertical Media Stack Preview */
    .project-media-wrapper {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      justify-content: center;
      align-items: center;
      padding-right: 2rem;
    }

    .project-media {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: none;
      height: var(--focus-height, auto);
      object-fit: contain;
      border-radius: 24px; /* Rounded card layout */
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    /* Shared Footer controls container matching your grid alignment */
    .carousel-controls {
      display: flex;
      width: 100%;
      margin-top: 1.5rem;
      padding: 0;
    }

    .carousel-status-wrapper {
      display: flex;
      width: 100%;
      max-width: none;
      padding-right: 0;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .carousel-status {
      color: var(--text);
      font-size: 0.95rem;
    }

    .status-dots-divider {
      flex-grow: 1;
      margin-right: 1rem;
      border-top: 2px dotted var(--description);
    }

    .carousel-buttons {
      display: flex;
      background-color: #a5a5a5;
      border-radius: 6px;
      padding: 2px;
      gap: 2px;
    }

    .carousel-button {
      width: 2.2rem;
      height: 2.2rem;
      border: none;
      background: var(--background);
      color: var(--text);
      cursor: pointer;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      transition: background-color 0.1s ease;
    }

    .carousel-button:hover,
    .carousel-button:focus-visible {
      background: var(--text);
      color: var(--background);
    }
  /* Responsive Mobile Overrides */
    @media (max-width: 850px) {
      .carousel-viewport, .project-slide, .carousel-controls {
        grid-template-columns: 1fr;
      }
      .grid-line-middle {
        display: none;
      }
      .carousel-viewport {
        height: 100vh;
      }
      .project-slide {
        padding: 1rem 0;
      }
      .project-card {
        padding: 1rem;
        height: auto;
      }
      .project-media-wrapper {
        height: auto;
        padding: 1rem;
      }
      .project-media {
        width: auto;
        max-width: 100%;
        max-height: none;
      }
      .status-dots-divider {
        display: none;
      }
    }
  </style>
</head>
<body>

  <Navigation />

  <main id="main-content" class="main-container">
  <!-- Section 1: Hero -->
  <section class="hero-section">
    <h1>Selected work.</h1>
    <p>A collection of projects exploring **web design, UX/UI, branding, and accessibility.**</p>
  </section>

    <section class="portfolio-carousel" aria-label="Selected projects" data-carousel>
      <div class="carousel-viewport">
      <!-- Structural blueprint division helper -->
        <div class="carousel-track">

          <article class="project-slide">
            <div class="project-card">
              <div class="project-card-header">
              <p class="project-category">Web Design <span aria-hidden="true">·</span> UX/UI <span aria-hidden="true">·</span> Accessibility</p>
              <h2>Splitli</h2>
              </div>
              <p class="project-description">A beginner-friendly fitness website designed to make understanding workout splits feel less intimidating.</p>
              <div class="project-action-row">
              <a href="/case-studies/splitli/" class="project-link">View Project <span aria-hidden="true">→</span></a>
              <span class="project-date">Spring 2026</span>
              </div>
            </div>
            <div class="grid-line-middle"></div>
            <div class="project-media-wrapper">
              <img class="project-media" style="background-color: #ff3399;" src="/images/featured-work-1.png" alt="Splitli project preview">
            </div>
          </article>

          <article class="project-slide">
            <div class="project-card">
              <div class="project-card-header">
              <p class="project-category">Web Design <span aria-hidden="true">·</span> Branding <span aria-hidden="true">·</span> UX/UI</p>
              <h2>Hyrax Haven</h2>
            </div>
              <p class="project-description">A playful nonprofit-style website bringing the fascinating world of hyraxes to life through branding, storytelling, and web design.</p>
              <div class="project-action-row">
              <a href="/case-studies/hyrax-haven/" class="project-link">View Project <span aria-hidden="true">→</span></a>
              <span class="project-date">Spring 2026</span>
            </div>
          </div>
          <div class="grid-line-middle"></div>
          <div class="project-media-wrapper">
            <img class="project-media" style="background-color: #33a8ff;" src="/images/featured-work-2.png" alt="Hyrax Haven project preview">          
          </div>
        </article>

          <article class="project-slide">
            <div class="project-card">
              <div class="project-card-header">
              <p class="project-category">Web Design <span aria-hidden="true">·</span> UX/UI <span aria-hidden="true">·</span> Interaction Design</p>
              <h2>Bartenders Glossary</h2>
            </div>
              <p class="project-description">An interactive digital glossary designed to make the world of cocktails, tools, and bartending terminology easier to explore.</p>
              <div class="project-action-row">
              <a href="/case-studies/bartenders-glossary/" class="project-link">View Project <span aria-hidden="true">→</span></a>
              <span class="project-date">Summer 2026</span>
            </div>
          </div>
          <div class="grid-line-middle"></div>
          <div class="project-media-wrapper">
            <img class="project-media" style="background-color: #33ffaa;" src="/images/featured-work-3.png" alt="Bartenders Glossary project preview">
          </div>
        </article>

          <article class="project-slide">
            <div class="project-card">
              <div class="project-card-header">
              <p class="project-category">UX/UI <span aria-hidden="true">·</span> App Design <span aria-hidden="true">·</span> Prototyping</p>
              <h2>Everyday Energy</h2>
            </div>
              <p class="project-description">A wellness mobile app concept designed to help users better understand and track their everyday habits.</p>
              <div class="project-action-row">
              <a href="/case-studies/everyday-energy/" class="project-link">View Project <span aria-hidden="true">→</span></a>
              <span class="project-date">Summer 2026</span>
            </div>
          </div>
          <div class="grid-line-middle"></div>
          <div class="project-media-wrapper">
            <img class="project-media" src="/images/featured-work-1.png" alt="Everyday Energy project preview">
          </div>
        </article>

          <article class="project-slide">
            <div class="project-card">
              <div class="project-card-header">
              <p class="project-category">Editorial Design <span aria-hidden="true">·</span> Layout <span aria-hidden="true">·</span> Typography</p>
              <h2>Scoop Strong</h2>
            </div>
              <p class="project-description">An ice cream recipe book and guide for the Ninja Creami, centered around the idea of enjoying hitting your macros.</p>
              <div class="project-action-row">
              <a href="/case-studies/scoop-strong/" class="project-link">View Project <span aria-hidden="true">→</span></a>
              <span class="project-date">Summer 2026</span>
            </div>
          </div>
          <div class="grid-line-middle"></div>
          <div class="project-media-wrapper">
            <img class="project-media" src="/images/featured-work-2.png" alt="Scoop Strong project preview">
          </div>
        </article>
        </div>
      </div>
      <div class="carousel-controls">
        <div class="carousel-status-wrapper">
          <span class="carousel-status" aria-live="polite">Project 1 of 5</span>
          <div class="status-dots-divider" aria-hidden="true"></div>
          <div class="carousel-buttons">
            <button class="carousel-button" type="button" data-carousel-prev aria-label="Previous project">↑</button>
            <button class="carousel-button" type="button" data-carousel-next aria-label="Next project">↓</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing Statement -->
    <h2>Like what you see?</h2>
    <p>I’m always looking for interesting problems to solve and new things to make.</p>
    <a href="/contact/">Let’s Talk <span aria-hidden="true">→</span></a>
  </main>

  <Footer />

  <script>
    const carousel = document.querySelector('[data-carousel]');
    const viewport = carousel?.querySelector('.carousel-viewport');
    const track = carousel?.querySelector('.carousel-track');
    const slides = carousel?.querySelectorAll('.project-slide');
    const status = carousel?.querySelector('.carousel-status');
    const controls = carousel?.querySelector('.carousel-controls');
    let currentSlide = 0;

    const firstSlideClone = slides?.[0]?.cloneNode(true);
    const lastSlideClone = slides?.[slides.length - 1]?.cloneNode(true);
    if (track && firstSlideClone && lastSlideClone) {
      track.prepend(lastSlideClone);
      track.append(firstSlideClone);
    }

    const allSlides = [...(slides ?? []), lastSlideClone, firstSlideClone].filter(Boolean);

    const syncFocusMedia = (slide) => {
      const projectCard = slide?.querySelector('.project-card');
      if (!slide || !projectCard) return;
      slide.style.setProperty('--focus-height', `${projectCard.getBoundingClientRect().height}px`);
    };

    const clearTransitionState = () => {
      allSlides.forEach((slide) => {
        slide.classList.remove(
          'is-transition-source',
          'is-transition-target',
          'is-forward',
          'is-backward',
          'is-revealing'
        );
      });
    };

    const updateCarousel = (nextSlide) => {
      if (!viewport || !track || !slides || !status || !controls) return;
      const isRefresh = nextSlide === currentSlide;
      const wrapsForward = currentSlide === slides.length - 1 && nextSlide >= slides.length;
      const wrapsBackward = currentSlide === 0 && nextSlide < 0;
      const movingForward = wrapsForward || (!wrapsBackward && nextSlide > currentSlide);
      const previousSlide = slides[currentSlide];
      currentSlide = (nextSlide + slides.length) % slides.length;
      const activeSlide = slides[currentSlide];
      const targetSlide = wrapsForward
        ? firstSlideClone
        : wrapsBackward
          ? lastSlideClone
          : activeSlide;

      if (isRefresh) {
        clearTransitionState();
        targetSlide.querySelector('.project-card')?.append(controls);
        syncFocusMedia(targetSlide);
        track.style.transform = `translateY(-${activeSlide.offsetTop}px)`;
        status.textContent = `Project ${currentSlide + 1} of ${slides.length}`;
        return;
      }

      clearTransitionState();
      previousSlide.classList.add('is-transition-source');
      targetSlide.classList.add(
        'is-transition-target',
        movingForward ? 'is-forward' : 'is-backward'
      );
      targetSlide.querySelector('.project-card')?.append(controls);
      syncFocusMedia(targetSlide);
      track.style.transform = `translateY(-${targetSlide.offsetTop}px)`;
      status.textContent = `Project ${currentSlide + 1} of ${slides.length}`;

      if (wrapsForward || wrapsBackward) {
        track.addEventListener('transitionend', () => {
          track.style.transition = 'none';
          activeSlide.querySelector('.project-card')?.append(controls);
          track.style.transform = `translateY(-${activeSlide.offsetTop}px)`;
          track.offsetHeight;
          track.style.removeProperty('transition');
          clearTransitionState();
        }, { once: true });
      } else {
        track.addEventListener('transitionend', clearTransitionState, { once: true });
      }
    };

    if (track && slides?.length && lastSlideClone) {
      syncFocusMedia(lastSlideClone);
      track.style.transition = 'none';
      track.style.transform = `translateY(-${slides[0].offsetTop}px)`;
      track.offsetHeight;
      track.style.removeProperty('transition');
    }

    updateCarousel(0);
    carousel?.querySelector('[data-carousel-prev]')?.addEventListener('click', () => updateCarousel(currentSlide - 1));
    carousel?.querySelector('[data-carousel-next]')?.addEventListener('click', () => updateCarousel(currentSlide + 1));
    window.addEventListener('resize', () => {
      if (!viewport || !track || !slides) return;
      clearTransitionState();
      syncFocusMedia(slides[currentSlide]);
      track.style.transition = 'none';
      track.style.transform = `translateY(-${slides[currentSlide].offsetTop}px)`;
      track.offsetHeight;
      track.style.removeProperty('transition');
    });
  </script>

</body>
</html>
