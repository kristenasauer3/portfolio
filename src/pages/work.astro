---
// src/pages/work.astro
import Navigation from '../components/Navigation.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Work | Portfolio</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      color: #1a1a1a;
    }
    .main-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }
    h1 { 
      font-size: 2.5rem; 
      margin-bottom: 3rem; 
    }
    
    /* Accessible grid pattern layout */
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 3rem;
    }
    .project-card {
      text-decoration: none;
      color: #1a1a1a;
      display: block;
    }
    .image-placeholder {
      background-color: #f5f5f5;
      aspect-ratio: 16 / 10;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #666;
    }
    .project-card h2 { 
      font-size: 1.5rem; 
      margin: 0 0 0.5rem 0; 
    }
    .project-card p { 
      color: #555; 
      margin: 0; 
      font-size: 1.1rem; 
    }
    .project-card:hover h2, .project-card:focus h2 { 
      text-decoration: underline; 
    }
  </style>
</head>
<body>

  <!-- Reusable Navigation Component -->
  <Navigation />

  <main id="main-content" class="main-container">
  <!-- Section 1: Hero -->
  <section-class="hero-section">
    <h1>Selected work.</h1>
    <p>A collection of projects exploring **web design, UX/UI, branding, and accessibility.**</p>
  </section>

  <!-- Section 2: Project Intro -->
  <section-class="project-intro-section">
    <h2>Design with a purpose.</h2>
    <p>Every project starts with a problem to solve. I like figuring out how visual design, technology, and user needs can come together to create something functional and memorable.</p>
  </section>

    <div class="portfolio-grid">

      <!-- Project 1 Card -->
      <a href="/portfolio/case-studies/splitli/" class="project-card">
        <div class="image-placeholder">Splitli Mockup</div>
        <h2>Splitli</h2>
        <p class="project-description">A beginner-friendly fitness website designed to make understanding workout splits feel less intimidating.</p>
        <p class="project-category">Web Design <span aria-hidden="true">·</span> UX/UI <span aria-hidden="true">·</span> Accessibility</p>
        <a href="/portfolio/case-studies/splitli/">View Project <span aria-hidden="true">→</span></a>
      
      </a>

      <!-- Project 2 Card -->
      <a href="/portfolio/case-studies/hyrax-haven/" class="project-card">
        <div class="image-placeholder">Hyrax Haven Mockup</div>
        <h2>Hyrax Haven</h2>
        <p class="project-description">A playful nonprofit-style website bringing the fascinating world of hyraxes to life through branding, storytelling, and web design.</p>
        <p class="project-category">Web Design <span aria-hidden="true">·</span> Branding <span aria-hidden="true">·</span> UX/UI</p>
        <a href="/portfolio/case-studies/hyrax-haven/">View Project <span aria-hidden="true">→</span></a>

      </a>

      <!-- Project 3 Card -->
      <a href="/portfolio/case-studies/bartenders-glossary/" class="project-card">
        <div class="image-placeholder">Bartenders Glossary Mockup</div>
        <h2>Bartenders Glossary</h2>
        <p class="project-description">An interactive digital glossary designed to make the world of cocktails, tools, and bartending terminology easier to explore.</p>
        <p class="project-category">Web Design <span aria-hidden="true">·</span> UX/UI <span aria-hidden="true">·</span> Interaction Design</p>
        <a href="/portfolio/case-studies/bartenders-glossary/">View Project <span aria-hidden="true">→</span></a>

      </a>

      <!-- Project 4 Card -->
      <a href="/portfolio/case-studies/everyday-energy/" class="project-card">
        <div class="image-placeholder">Everyday Energy Mockup</div>
        <h2>Everyday Energy</h2>
        <p class="project-description">A wellness mobile app concept designed to help users better understand and track their everyday habits.</p>
        <p class="project-category">UX/UI <span aria-hidden="true">·</span> App Design <span aria-hidden="true">·</span> Prototyping</p>
        <a href="/portfolio/case-studies/everyday-energy/">View Project <span aria-hidden="true">→</span></a>
      </a>


      <!-- Project 5 Card -->
      <a href="/portfolio/case-studies/scoop-strong/" class="project-card">
        <div class="image-placeholder">Scoop Strong Mockup</div>
        <h2>Scoop Strong</h2>
        <p class="project-description">An ice cream recipe book and guide for the Ninja Creami, centered around the idea of enjoying hitting your macros.</p>
        <p class="project-category">Editorial Design <span aria-hidden="true">·</span> Layout <span aria-hidden="true">·</span> Typography</p>
        <a href="/portfolio/case-studies/scoop-strong/">View Project <span aria-hidden="true">→</span></a>

      </a>

    </div>
  </main>

</body>
</html>
