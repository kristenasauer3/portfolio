---
import Navigation from '../components/Navigation.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Work | Portfolio</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      color: #1a1a1a;
    }
    .main-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }
    h1 { font-size: 2.5rem; margin-bottom: 3rem; }
    
    /* Accessible 2-column grid pattern */
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 3rem;
    }
    .project-card {
      text-decoration: none;
      color: #1a1a1a;
      display: block;
    }
    .image-placeholder {
      background-color: #f5f5f5;
      aspect-ratio: 16 / 10;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #666;
    }
    .project-card h2 { font-size: 1.5rem; margin: 0 0 0.5rem 0; }
    .project-card p { color: #555; margin: 0; font-size: 1.1rem; }
    .project-card:hover h2, .project-card:focus h2 { text-decoration: underline; }
  </style>
</head>
<body>

  <Navigation />

  <main id="main-content" class="main-container">
    <h1>Selected Work</h1>
    
    <div class="portfolio-grid">
      <!-- Project 1 Card -->
      <a href="/portfolio/case-studies/project-one/" class="project-card">
        <div class="image-placeholder">Drag mockup image here inside Finder later</div>
        <h2>Brand Identity Overhaul</h2>
        <p>Visual Systems / Creative Direction</p>
      </a>

      <!-- Project 2 Card -->
      <a href="/portfolio/case-studies/project-two/" class="project-card">
        <div class="image-placeholder">Project 2 Layout Preview</div>
        <h2>Editorial Magazine Design</h2>
        <p>Print / Typography Layout</p>
      </a>

      <!-- Repeat this pattern block below to add your remaining 6 projects! -->
    </div>
  </main>

</body>
</html>
