---
// src/pages/work.astro
import Navigation from '../components/Navigation.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Selected Work | Portfolio</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      color: #1a1a1a;
    }
    .main-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }
    h1 { 
      font-size: 2.5rem; 
      margin-bottom: 3rem; 
    }
    
    /* Accessible grid pattern layout */
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 3rem;
    }
    .project-card {
      text-decoration: none;
      color: #1a1a1a;
      display: block;
    }
    .image-placeholder {
      background-color: #f5f5f5;
      aspect-ratio: 16 / 10;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #666;
    }
    .project-card h2 { 
      font-size: 1.5rem; 
      margin: 0 0 0.5rem 0; 
    }
    .project-card p { 
      color: #555; 
      margin: 0; 
      font-size: 1.1rem; 
    }
    .project-card:hover h2, .project-card:focus h2 { 
      text-decoration: underline; 
    }
  </style>
</head>
<body>

  <!-- Reusable Navigation Component -->
  <Navigation />

  <main id="main-content" class="main-container">
    <h1>Selected Work</h1>
    
    <div class="portfolio-grid">
      <!-- Project 1 Card -->
      <a href="/portfolio/case-studies/bartenders-glossary/" class="project-card">
        <div class="image-placeholder">Bartenders Glossary Mockup</div>
        <h2>Bartenders Glossary</h2>
        <p>Web Design / UX</p>
      </a>

      <!-- Project 2 Card -->
      <a href="/portfolio/case-studies/everyday-energy/" class="project-card">
        <div class="image-placeholder">Everyday Energy Mockup</div>
        <h2>Everyday Energy</h2>
        <p>Brand Identity / Visual Systems</p>
      </a>

      <!-- Project 3 Card -->
      <a href="/portfolio/case-studies/hyrax-haven/" class="project-card">
        <div class="image-placeholder">Hyrax Haven Mockup</div>
        <h2>Hyrax Haven</h2>
        <p>Web Design / Creative Direction</p>
      </a>

      <!-- Project 4 Card -->
      <a href="/portfolio/case-studies/scoop-strong/" class="project-card">
        <div class="image-placeholder">Scoop Strong Mockup</div>
        <h2>Scoop Strong</h2>
        <p>Brand Identity / Packaging</p>
      </a>

      <!-- Project 5 Card -->
      <a href="/portfolio/case-studies/splitli/" class="project-card">
        <div class="image-placeholder">Splitli Mockup</div>
        <h2>Splitli</h2>
        <p>App Design / UX/UI</p>
      </a>

    </div>
  </main>

</body>
</html>
