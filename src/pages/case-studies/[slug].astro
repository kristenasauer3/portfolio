---
// src/pages/case-studies/[slug].astro
import projects from '../../data/projects.json';
import ImageGallery from '../../components/ImageGallery.astro';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={project.description} />
    <title>{project.title} | Portfolio Case Study</title>
  </head>
  <body>
    <!-- WCAG AA Requirement: Skip Link for keyboard users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Wrapper injecting page themes securely -->
    <div class={`case-study-container ${project.theme || 'light-theme'}`}>
      
      <main id="main-content" tabindex="-1">
        <header class="case-study-header">
          <h1>{project.title}</h1>
        </header>
        
        <!-- Safe HTML injection maintaining semantic elements, ARIA nodes, and nested headings -->
        <article class="case-study-body" set:html={project.htmlContent} />

        <!-- Highly accessible image gallery component instantiation -->
        <ImageGallery images={project.images} projectTitle={project.title} />
        
        <footer class="case-study-footer">
          <a href="/case-studies" class="back-link">
            <span aria-hidden="true">←</span> Back to all case studies
          </a>
        </footer>
      </main>

    </div>
  </body>
</html>

<style>
  /* --- WCAG AA Accessible Base Styles --- */
  
  /* Skip Link Styling (hidden until focused via keyboard Tab) */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: #0056b3;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    z-index: 100;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
  }
  .skip-link:focus {
    top: 1rem;
    outline: 3px solid #ffcc00;
    outline-offset: 2px;
  }

  /* Structural Containers */
  .case-study-container {
    min-height: 100vh;
    padding: 2rem 1.5rem;
    transition: background-color 0.2s ease;
  }
  
  main {
    max-width: 800px; /* Optimal readability width (around 70-80 characters per line) */
    margin: 0 auto;
  }
  main:focus {
    outline: none; /* Accessible remove outline ONLY because target is programmatically focused via skip link */
  }

  /* Typography & Contrast Regulations (Ensuring minimum 4.5:1 contrast ratios) */
  .light-theme {
    background-color: #ffffff;
    color: #1a202c; /* Clean off-black */
  }
  .dark-theme {
    background-color: #1a202c;
    color: #edf2f7; /* Off-white */
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem); /* Responsive fluid typography */
    line-height: 1.2;
    margin-bottom: 2rem;
  }

  /* Targeting Dynamically Injected Content Securely */
  .case-study-body :global(p) {
    font-size: 1.125rem; /* Accessible base sizing (18px equivalent) */
    line-height: 1.75;  /* WCAG rule: line-height at least 1.5 times the font size */
    margin-bottom: 1.75rem;
    color: inherit;
  }

  .case-study-body :global(h3) {
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .case-study-body :global(.custom-callout) {
    border-left: 4px solid #0056b3;
    background-color: rgba(0, 86, 179, 0.06);
    padding: 1.25rem;
    margin: 2rem 0;
    border-radius: 0 8px 8px 0;
  }

  /* Dark Theme Callout Contrast Readjustment */
  .dark-theme .case-study-body :global(.custom-callout) {
    border-left-color: #66b2ff;
    background-color: rgba(102, 178, 255, 0.12);
  }

  /* Navigation Links styling */
  .back-link, .case-study-body :global(a) {
    color: #0056b3;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .dark-theme .back-link, .dark-theme .case-study-body :global(a) {
    color: #66b2ff;
  }

  /* Clear focus indicator rules for everything */
  .case-study-container :global(a:focus), 
  .case-study-container :global(button:focus) {
    outline: 3px solid #ffcc00 !important;
    outline-offset: 2px !important;
  }
</style>
