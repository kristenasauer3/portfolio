---
import '../../styles/global.css';
import projects from '../../data/projects.json';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const currentProjectIndex = projects.findIndex(({ slug }) => slug === project.slug);
const nextProject = projects[(currentProjectIndex + 1) % projects.length];
const nextProjectImage = project.upNextImage ?? nextProject.sections.find(({ image }) => image)?.image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={project.description} />
    <title>{project.title} | Portfolio Case Study</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class:list={['case-study-hero', { 'has-hero-image': project.heroImage }]}>
      {project.heroImage && (
        <img class="hero-image" src={project.heroImage.url} alt={project.heroImage.alt} decoding="async" />
      )}
      <Navigation />
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span class="hero-project-type">{project.projectType}</span>
          <span class="hero-project-separator" aria-hidden="true">·</span>
          <span class="hero-project-date">{project.projectDate}</span>
        </p>
        <h1>{project.title}</h1>
        <p class="hero-description">{project.description}</p>
        {project.siteUrl && <a class="hero-site-link" href={project.siteUrl} target="_blank" rel="noopener noreferrer">Visit Page <span aria-hidden="true">→</span></a>}
      </div>
      {!project.heroImage && <span class="hero-mark" aria-hidden="true">✳</span>}
    </header>

    <main id="main-content" tabindex="-1">
      <div class="case-study-sections">
        {project.sections.map((section) => (
          <section class="content-section">
            <div class="section-copy">
              <h2>{section.title}</h2>
              <div class="section-paragraphs">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
            <figure class="section-image" aria-hidden={!section.image}>
              {section.image && (
                <img src={section.image.url} alt={section.image.alt} loading="lazy" decoding="async" />
              )}
            </figure>
          </section>
        ))}

        {project.gallery.length > 0 && (
          <section class="product-gallery" aria-labelledby="product-heading">
            <h2 id="product-heading">The Product</h2>
            <div class="product-grid">
              {project.gallery.map((image) => (
                <figure>
                  <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          </section>
        )}

        <a class="next-project" href={`/case-studies/${nextProject.slug}/`}>
          <span class="next-copy">
            <span class="next-eyebrow">Up Next</span>
            <span class="next-title">{nextProject.title}</span>
          </span>
          <span class="next-rule" aria-hidden="true"></span>
          {nextProjectImage && (
            <img class="next-image" src={nextProjectImage.url} alt="" loading="lazy" />
          )}
          <span class="next-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 10;
    top: -5rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    color: var(--text);
    background: var(--background);
    font-weight: 700;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .case-study-hero {
    position: relative;
    display: flex;
    min-height: 30rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    margin: -3rem calc(50% - 50vw) 0;
    padding: 0  max(1.5rem, calc((100vw - 1100px) / 2));
    color: #ffffff;
  }

  .case-study-hero.has-hero-image {
    background: none;
  }

  .hero-image {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    filter: brightness(0.3);
    object-fit: cover;
    object-position: center;
  }

  :global(.case-study-hero .navigation) {
    z-index: 1;
    width: 100%;
    margin: 0 auto;
  }

  :global(.case-study-hero .nav-link),
  :global(.case-study-hero .nav-logo),
  :global(.case-study-hero .theme-toggle) {
    color: #ffffff;
  }

  .hero-copy {
    position: relative;
    z-index: 10;
    width: min(34rem, 75%);
    padding: 2.4rem 0 10rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1.0rem;
    margin: 0 0 0.8rem;
    font-size: 1.0rem;
    font-style: italic;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .hero-project-type {
    font-weight: 400;
  }

  .hero-project-date {
    font-weight: 400;
  }

  .hero-copy h1 {
    margin: 0 0 0.8rem;
    font-size: clamp(2.3rem, 5.5vw, 4.5rem);
    line-height: 1.04;
  }

  .hero-description {
    max-width: 28rem;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    font-weight: 300;
  }

  .hero-site-link {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    background-color: #ffffff;
    color: #000000;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }


  .hero-mark {
    position: absolute;
    right: 8%;
    bottom: -7rem;
    color: rgb(255 255 255 / 13%);
    font-size: clamp(19rem, 40vw, 35rem);
    line-height: 1;
    transform: rotate(-15deg);
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
  }

  main:focus {
    outline: none;
  }

  .case-study-sections {
    margin-left: clamp(-1.5rem, calc(550px - 50vw), 0px);
    padding: 4rem 0;
  }

  .content-section {
    display: flex;
    align-items: flex-end;
    gap: 2.5rem;
    padding: 1.25rem 0 2rem;
  }

  .content-section + .content-section {
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  .section-copy {
    display: flex;
    align-self: stretch;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    flex: 0.8 1 0;
  }

  .section-copy h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.2;
  }

  .product-gallery h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.2;
  }

  .section-paragraphs p {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.65;
  }

  .section-paragraphs p:last-child {
    margin-bottom: 0;
  }

  .section-image,
  .product-grid figure {
    overflow: hidden;
    margin: 0;
    background: #e9e7e4;
  }

  .section-image {
    width: 100%;
    flex: 1.10 1 0;
    aspect-ratio: 1.6;
  }

  .section-image img,
  .product-grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery {
    padding: 1.5rem 0 2rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .product-grid figure {
    aspect-ratio: 1.6;
  }

  .product-grid figure:nth-child(3) {
    grid-column: 1 / -1;
    aspect-ratio: 3.2;
  }

  .next-project {
    display: flex;
    min-height: 7rem;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0 2rem;
    color: inherit;
    text-decoration: none;
  }

  .next-copy {
    display: flex;
    min-width: max-content;
    flex-direction: column;
    gap: 0.2rem;
  }

  .next-eyebrow {
    color: var(--description);
  }

  .next-title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .next-rule {
    height: 1px;
    flex: 1;
    background-image: radial-gradient(circle, currentColor 1px, transparent 1.5px);
    background-position: center;
    background-size: 8px 2px;
  }

  .next-image {
    width: clamp(6rem, 23vw, 12rem);
    height: 5rem;
    object-fit: cover;
  }

  .next-arrow {
    font-size: 1.5rem;
  }

  .next-project:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  :global(html[data-theme='dark']) .section-image,
  :global(html[data-theme='dark']) .product-grid figure {
    background: #292929;
  }

  @media (max-width: 650px) {
    .case-study-hero {
      min-height: 25rem;
      padding-inline: 1.25rem;
    }

    :global(.case-study-hero .navigation) {
      padding-inline: 0;
    }

    .hero-copy {
      width: 100%;
      padding-bottom: 3.5rem;
    }

    .hero-mark {
      right: -4rem;
      bottom: -4rem;
      font-size: 18rem;
    }

    .case-study-sections {
      padding-top: 1rem;
    }

    .content-section {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.5rem 0;
    }

    .section-copy,
    .section-image {
      flex: none;
    }

    .product-grid {
      grid-template-columns: 1fr;
    }

    .product-grid figure:nth-child(3) {
      aspect-ratio: 1.6;
    }

    .next-project {
      gap: 0.65rem;
    }

    .next-copy {
      min-width: 0;
    }

    .next-title {
      font-size: 1rem;
    }
  }
</style>
