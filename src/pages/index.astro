---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Graphic Design Portfolio</title>
  <style>
    .hero h1 {
      font-size: clamp(3.0rem, 10vw, 6.0rem);
      margin-bottom: 1rem;
      color: var(--text);
      text-align: center;
      grid-column: 1 / -1;
    }
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2rem;
      margin-bottom: 3rem;
      padding: 1rem 1.5rem 5rem;
    }
    .hero-copy {
      min-width: 0;
    }
    .hero p {
      font-size: 1.14rem;
      color: var(--text);
      line-height: 1.6;
      margin: 0;
      max-width: 600px;
    }
    .hero-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }
    .cta-link {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: var(--text);
      color: var(--background);
      text-decoration: none;
      border-radius: 4px;
      font-weight: 600;
      transition: background-color 0.2s ease;
    }
    .cta-link:hover {
      background-color: var(--secondary-alt);
      color: var(--text);
      transition: 0.35s;
    }
    @media (max-width: 768px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      .hero-actions {
        flex-wrap: wrap;
      }
    }
    /* Main wrapper container */
    .card-grid-container {
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 1100px;
      margin: 40px auto;
      padding: 0;
    }

    /* Each row expands horizontally while preserving its gap. */
    .card-row {
      display: flex;
      width: 100%;
      gap: 20px;
    }

    .card {
      display: flex;
      align-items: flex-end;
      min-width: 0;
      min-height: 220px;
      padding: 30px;
      border-radius: 24px;
      text-decoration: none;
      color: var(--text);
      flex: 1 1 0;
      transition:
        flex 0.6s cubic-bezier(0.25, 1, 0.5, 1),
        color 300ms ease,
        background-color 300ms ease;
    }

    /* Work and Contact begin at two thirds of their row. */
    .card-work,
    .card-contact {
      flex: 2 1 0;
    }

    /* On hover, shrink only the sibling so the active card stays at 7:1. */
    .card-row:has(.card:hover) .card:not(:hover) {
      flex: 1 1 0;
    }

    .card:hover {
      flex: 7 1 0;
    }

/* Text styling inside the boxes */
.card h2 {
  color: var(--text);
  font-family: sans-serif;
  font-size: 2rem;
  margin: 0;
  font-weight: bold;
}


/* Color definitions */
.card-about {
  background-color: var(--primary);
}
.card-contact {
  background-color: var(--secondary);
}
.card-work {
  background-color: var(--secondary-alt);
}
.card-filler {
  background-color: var(--primary-alt);
}

:global(html[data-theme='dark']) .card-about {
  background-color: var(--primary);
}

:global(html[data-theme='dark']) .card-contact {
  background-color: var(--secondary);
}

:global(html[data-theme='dark']) .card-work {
  background-color: var(--secondary-alt);
}

:global(html[data-theme='dark']) .card-filler {
  background-color: var(--primary-alt);
}

/* Responsive adjustment for mobile screens */
@media (max-width: 768px) {
  .card-row {
    flex-direction: column;
  }
  .card,
  .card-work,
  .card-contact,
  .card:hover {
    flex: none;
    width: 100%;
  }
}
    .project-section {
      margin-top: 3rem;
      padding-top: 2rem;
    }
    .project-section h2 {
      font-size: 1.0rem;
      margin-bottom: 1rem;
    }
  .intro-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: linear-gradient(
      to bottom,
      var(--background) 0%,
      var(--primary) 18%,
      var(--primary) 82%,
      var(--background) 100%
    );
    margin-bottom: 3rem;
    padding: 20rem 1.5rem;
  }
  .intro-section h2 {
    font-size: 2.25rem;
    margin: 0;
    line-height: 1.2;
    text-align: center;
  }
  .intro-section h2 span {
    display: block;
    color: var(--background);
  }
  .intro-section p {
    display: flex;
    font-size: 1.0rem;
    margin: 0 auto;
    line-height: 1.6;
    max-width: 650px;
  }
  @media (max-width: 768px) {
    .intro-section {
      gap: 1.5rem;
    }
  }

  .specialties-section {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.75fr);
    gap: 4rem;
    align-items: start;
    padding: 3rem 1.5rem;
  }

  .specialties-section h2 {
    font-size: 2.5rem;
    grid-column: 1;
    margin: 0;
  }

  .specialty-list {
    grid-column: 1;
    display: grid;
    gap: 1.25rem;
  }

  .specialty {
    position: relative;
    padding-bottom: 1.25rem;
  }

  .specialty:has(.specialty-button[aria-expanded="true"]) {
    padding-left: 1rem;
  }

  .specialty:has(.specialty-button[aria-expanded="true"])::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 1.25rem;
    left: 0;
    width: 0.25rem;
    background: var(--primary);
  }

  .specialty h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .specialty-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: color 0.45s ease;
  }

  .specialty-button[aria-expanded="false"] {
    color: var(--light-hover);
  }

  .specialty-button:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 0.35rem;
  }

  .specialty p {
    max-width: 32rem;
    margin: 0.65rem 0 0;
    line-height: 1.6;
  }

  .specialty-visual {
    position: sticky;
    top: 2rem;
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: stretch;
    margin: 0;
    overflow: hidden;
    background: #f1f1f1;
  }

  .specialty-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to left, transparent 65%, var(--background));
    pointer-events: none;
  }

  .specialty-visual img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
  }

  .specialty-visual img[data-active="true"] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  @media (max-width: 768px) {
    .specialties-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .specialties-section h2,
    .specialty-list {
      grid-column: 1;
    }

    .specialty-visual {
      position: static;
      grid-column: 1;
      grid-row: 3;
      aspect-ratio: 4 / 3;
    }
  }
  .featured-section {
    display: grid;
    gap: 0.75rem;
    margin: 3rem 0;
    padding: 1.0rem 0;
  }

  .featured-section h2,
  .featured-section > p,
  .featured-section > .cta-link {
    justify-self: start;
  }

  .featured-section h2 {
    font-size: 2.25rem;
    margin: 0;
    padding: 0.5rem 0;
  }

  .featured-section > p {
    font-size: 1rem;
    max-width: 40rem;
    margin: 0;
    padding: 0 0 1.0rem 0;
    }

  .featured-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .featured-card {
    position: relative;
    display: block;
    overflow: hidden;
    color: var(--background);
    text-decoration: none;
  }

  .featured-card::after {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--text);
    content: '';
    opacity: 0;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    transition: opacity 0.2s ease;
  }

  .featured-card-splitli::after {
    mask-image: url('/images/featured-work-1.png');
    -webkit-mask-image: url('/images/featured-work-1.png');
  }

  .featured-card-energy::after {
    mask-image: url('/images/featured-work-2.png');
    -webkit-mask-image: url('/images/featured-work-2.png');
  }

  .featured-card-bartender::after {
    mask-image: url('/images/featured-work-3.png');
    -webkit-mask-image: url('/images/featured-work-3.png');
  }

  .featured-card:hover::after,
  .featured-card:focus-visible::after {
    opacity: 0.65;
  }

  .featured-card-content {
    position: absolute;
    z-index: 1;
    inset: 50% 1rem auto;
    color: var(--background);
    text-align: center;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .featured-card:hover .featured-card-content,
  .featured-card:focus-visible .featured-card-content {
    opacity: 1;
  }

  .featured-card-content h3,
  .featured-card-content p {
    margin: 0;
  }

  .featured-card-content h3 {
    font-size: 1.4rem;
    text-align: center;
  }

  .featured-card-content p {
    padding: 0;
    font-size: 1rem;
    text-align: center;
  }

  .featured-card:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 0.25rem;
  }

  .featured-card img {
    display: block;
    width: 100%;
    aspect-ratio: 3.25 / 3;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .featured-gallery {
      grid-template-columns: 1fr;
    }
  }

  .closing-section {
    padding: 4.5rem 0;
    text-align: center;
  }

  .closing-section h2 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem;
  }

  .closing-section p {
    font-size: 1rem;
    margin: 0 0 1.5rem;
    padding: 0;
  }
  </style>
</head>
<body>
  <Navigation />

  <header class="hero">
    <h1>Designing for people.</h1>
    <div class="hero-copy">
      <p>I'm Kristen, a graphic designer specializing in web design, UX/UI, and accessibility. I create digital experiences that look and feel good.</p>
    </div>
    <div class="hero-actions">
      <a href="/work/" class="cta-link">View My Work <span aria-hidden="true">→</span></a>
      <a href="/about/" class="cta-link">More About Me <span aria-hpublic/images/featured-work-1.pngidden="true">→</span></a>
    </div>
  </header>

<div class="card-grid-container">
  <!-- Top Row -->
  <div class="card-row">
    <a href="about.html" class="card card-about">
      <h2>About</h2>
    </a>
    <a href="work.html" class="card card-work">
      <h2>Work</h2>
    </a>
  </div>

  <!-- Bottom Row -->
  <div class="card-row">
    <a href="contact.html" class="card card-contact">
      <h2>Contact</h2>
    </a>
    <div class="card card-filler"></div>
  </div>
</div>

<!-- Section 1: Intro / What I Do -->
<section class="intro-section">
  <h2>Good design should work for <span>everyone.</span></h2>
  <p>Accessibility isn’t something I add at the end of a project. It’s part of my approach from the beginning. Whether I’m building a website, developing a brand, or even just picking a font, I’m always thinking about how someone will actually experience it.</p>
</section>

<!-- Section 2: Specialties -->
<section class="specialties-section">
  <h2>What I do</h2>
  <div class="specialty-list">
    <div class="specialty">
      <h3><button class="specialty-button" type="button" data-specialty="web-design" aria-expanded="true">Web Design</button></h3>
      <p data-specialty-text="web-design">Websites designed to be easy to navigate, engaging, and accessible across devices.</p>
    </div>
    <div class="specialty">
      <h3><button class="specialty-button" type="button" data-specialty="ux-ui" aria-expanded="false">UX / UI</button></h3>
      <p data-specialty-text="ux-ui" hidden>Turning ideas into digital experiences. I focus on clear structure, intuitive interactions, and user-centered design.</p>
    </div>
    <div class="specialty">
      <h3><button class="specialty-button" type="button" data-specialty="accessibility" aria-expanded="false">Accessibility</button></h3>
      <p data-specialty-text="accessibility" hidden>Designing for all. From visual hierarchy and color contrast to navigation, interaction, and content, I consider accessibility throughout the process.</p>
    </div>
    <div class="specialty">
      <h3><button class="specialty-button" type="button" data-specialty="graphic-design" aria-expanded="false">Graphic Design</button></h3>
      <p data-specialty-text="graphic-design" hidden>Brand identities, visual systems, and everything in between. I like making things look good and making sure they look that way for a reason.</p>
    </div>
  </div>
  <figure class="specialty-visual">
    <img data-specialty-image="web-design" data-active="true" src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1200&q=85" alt="Bright workspace with a laptop and design materials">
    <img data-specialty-image="ux-ui" src="https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=1200&q=85" alt="Designer working with colorful interface sketches">
    <img data-specialty-image="accessibility" src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1200&q=85" alt="Team collaborating around a table">
    <img data-specialty-image="graphic-design" src="https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&fit=crop&w=1200&q=85" alt="Graphic design tools and printed color swatches">
  </figure>
</section>

<!-- Section 3: Featured Work -->
<section class="featured-section">
  <h2>A few things I’ve made</h2>
  <p>A collection of websites, identities, and interactive experiences created with exploration, intention, and probably way too many tabs open.</p>
  <a href="/work/" class="cta-link">See All Work <span aria-hidden="true">→</span></a>
  <div class="featured-gallery">
    <a class="featured-card featured-card-splitli" href="/case-studies/splitli/">
      <img src="/images/featured-work-1.png" alt="A fitness website called "Splitli" shown on a laptop screen">
      <span class="featured-card-content">
        <h3>Splitli</h3>
        <p>Spring 2026</p>
      </span>
    </a>
    <a class="featured-card featured-card-energy" href="/case-studies/everyday-energy/">
      <img src="/images/featured-work-2.png" alt="A conceptual health tracking app called "Everyday Energy" shown on a phone screen held by a hand">
      <span class="featured-card-content">
        <h3>Everyday Energy</h3>
        <p>Fall 2025</p>
      </span>
    </a>
    <a class="featured-card featured-card-bartender" href="/case-studies/bartenders-glossary/">
      <img src="/images/featured-work-3.png" alt="A conceptual bartending website shown on a laptop screen">
      <span class="featured-card-content">
        <h3>Bartender's Glossary</h3>
        <p>Fall 2025</p>
      </span>
    </a>
  </div>

</section>

<!-- Section 4: Closing CTA -->
<section class="closing-section">
  <h2>Let’s make something that works.</h2>
  <p>Have a project, opportunity, or idea? I’d love to hear about it.</p>
  <a href="/contact/" class="cta-link">Get in Touch <span aria-hidden="true">→</span></a>

  <Footer />

<script>
  const specialtyButtons = document.querySelectorAll('[data-specialty]');
  const specialtyTexts = document.querySelectorAll('[data-specialty-text]');
  const specialtyImages = document.querySelectorAll('[data-specialty-image]');

  specialtyButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedSpecialty = button.dataset.specialty;

      specialtyButtons.forEach((currentButton) => {
        currentButton.setAttribute('aria-expanded', String(currentButton === button));
      });

      specialtyTexts.forEach((text) => {
        text.hidden = text.dataset.specialtyText !== selectedSpecialty;
      });

      specialtyImages.forEach((image) => {
        image.dataset.active = String(image.dataset.specialtyImage === selectedSpecialty);
      });
    });
  });
</script>

</body>
</html>
