---
// src/layouts/CaseStudyLayout.astro
const { title, client, role, year } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Design Portfolio</title>
  
  <style>
    /* WCAG AA Accessible Styles */
    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 2rem;
      background-color: #ffffff; /* Pure white background */
      color: #1a1a1a;            /* High contrast dark text (Over 4.5:1 ratio) */
      line-height: 1.75;         /* Accessible line spacing for readability */
    }
    
    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    .project-header {
      border-bottom: 2px solid #e0e0e0;
      padding-bottom: 2rem;
      margin-bottom: 2rem;
    }

    /* Accessible grid configuration */
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
      background-color: #f5f5f5; /* Light grey backdrop */
      padding: 1.5rem;
      border-radius: 8px;
    }

    /* Target text blocks inside the grid */
    .meta-item p {
      margin: 0;
    }

    /* High-contrast grey label text */
    .meta-label {
      display: block;
      color: #4a4a4a; 
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .meta-value {
      font-size: 1.15rem;
    }

    .project-content {
      font-size: 1.125rem; /* Large text size for easy reading */
    }
  </style>
</head>
<body>

  <div class="container">
    <header class="project-header">
      <!-- Main Heading (H1) tells assistive tech what the entire page is about -->
      <h1>{title}</h1>
      
      <!-- ARIA label tells screen readers this section lists project details -->
      <section class="meta-grid" aria-label="Project Details">
        <div class="meta-item">
          <span class="meta-label">Client</span>
          <span class="meta-value">{client}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Your Role</span>
          <span class="meta-value">{role}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Year</span>
          <span class="meta-value">{year}</span>
        </div>
      </section>
    </header>

    <!-- Main tag marks the primary content region of the page layout -->
    <main id="main-content" class="project-content">
      <slot />
    </main>
  </div>

</body>
</html>
