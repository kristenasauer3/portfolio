---
// src/layouts/CaseStudyLayout.astro
import Navigation from '../components/Navigation.astro';
const { title, client, role, year } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Design Portfolio</title>
  
  <style>
    /* WCAG AA Accessible Styles */
    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0; /* Changed to 0 so navigation stretches full-width */
      background-color: #ffffff;
      color: #1a1a1a;
      line-height: 1.75;
    }
    
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem; /* Content padding moved here */
    }

    .project-header {
      border-bottom: 2px solid #e0e0e0;
      padding-bottom: 2rem;
      margin-bottom: 2rem;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
      background-color: #f5f5f5;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .meta-item p { margin: 0; }

    .meta-label {
      display: block;
      color: #4a4a4a; 
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .meta-value { font-size: 1.15rem; }
    .project-content { font-size: 1.125rem; }
  </style>
</head>
<body>

  <!-- The Navigation Bar sits cleanly above your case study content -->
  <Navigation />

  <div class="container">
    <header class="project-header">
      <h1>{title}</h1>
      
      <section class="meta-grid" aria-label="Project Details">
        <div class="meta-item">
          <span class="meta-label">Client</span>
          <span class="meta-value">{client}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Your Role</span>
          <span class="meta-value">{role}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Year</span>
          <span class="meta-value">{year}</span>
        </div>
      </section>
    </header>

    <main id="main-content" class="project-content">
      <slot />
    </main>
  </div>

</body>
</html>
