---
// src/components/ImageGallery.astro
interface Props {
  images: string[]; // Accepts an array of image URLs
}

const { images } = Astro.props;
---

<div class="image-gallery">
  {images.map((src) => (
    <div class="gallery-item">
      <img src={src} alt="Case study screenshot" loading="lazy" />
    </div>
  ))}
</div>

<style>
  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin: 2rem 0;
  }
  .gallery-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
</style>
